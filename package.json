{
  "name": "@composio/openclaw-plugin",
  "version": "0.0.11",
  "type": "module",
  "description": "OpenClaw Composio plugin - access 1000+ third-party tools via Composio Tool Router",
  "keywords": [
    "openclaw",
    "composio",
    "tool-router",
    "agents",
    "mcp",
    "plugin"
  ],
  "homepage": "https://github.com/ComposioHQ/openclaw-composio-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/ComposioHQ/openclaw-composio-plugin.git"
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.4.27",
      "minGatewayVersion": ">=2026.4.27"
    },
    "build": {
      "openclawVersion": "2026.4.27"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
